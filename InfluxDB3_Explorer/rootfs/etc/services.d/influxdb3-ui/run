#!/usr/bin/with-contenv bashio

INFLUXDB_URL=$(bashio::config 'influxdb_url')
ADMIN_TOKEN=$(bashio::config 'admin_token')

bashio::log.info "Starting InfluxDB 3 Explorer UI..."
bashio::log.info "Connecting to InfluxDB at: $INFLUXDB_URL"

export INFLUXDB_URL="$INFLUXDB_URL"
export INFLUXDB_TOKEN="$ADMIN_TOKEN"

# Because we copied the root filesystem of the UI image to /opt/influxdb3-ui,
# we need to find its entrypoint or binary and run it.
# The exact command may depend on the upstream influxdb3-ui image.
# We will use chroot to execute it in the context of the copied filesystem 
# if it relies on specific paths, or just run its binary if it's standalone.

# Assuming the binary is at /opt/influxdb3-ui/usr/local/bin/influxdb3-ui or similar:
# Or, if it's a node app, we would run node.
# For now, we will just attempt to invoke its original entrypoint or binary.

if [ -f "/opt/influxdb3-ui/influxdb3-ui" ]; then
    cd /opt/influxdb3-ui
    exec ./influxdb3-ui --mode=admin
else
    # Fallback to just running what we assume is the entrypoint 
    # based on typical docker containers.
    # Needs to be adjusted once the image structure is known.
    bashio::log.warning "UI binary path might need adjustment based on the official image."
    # Just an example placeholder command:
    sleep 3600
fi
